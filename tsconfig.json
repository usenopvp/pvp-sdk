{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@usenopvp/sdk": [
        "./src/index.ts"
      ],
      "@usenopvp/sdk/vanity": [
        "./src/vanity.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "scripts",
    "examples"
  ]
}
